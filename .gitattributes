# Los .bat tienen que llevar saltos de línea de Windows: con saltos de Unix,
# cmd.exe pierde la cuenta de las posiciones y falla al buscar etiquetas.
*.bat   text eol=crlf

# El resto de texto, como venga; Git decide.
*       text=auto

# Binarios: que Git no intente tocarlos.
*.mo    binary
*.whl   binary
*.wav   binary
*.ico   binary
*.png   binary
*.zip   binary
*.cbr   binary
*.djvu  binary
*.pptx  binary
*.xlsx  binary
*.odp   binary
*.ods   binary
