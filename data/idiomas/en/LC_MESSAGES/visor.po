msgid "Claves API del servicio compatible con OpenAI"
msgstr "API keys for the OpenAI-compatible service"

msgid "Claves API, &una por línea:"
msgstr "API keys, &one per line:"

msgid "Co&piar al portapapeles"
msgstr "Co&py to the clipboard"

msgid "Colección"
msgstr "Collection"

msgid "Colección o asignatura"
msgstr "Collection or subject"

msgid "Colección o asignatura para «%s».\nDéjalo en blanco para quitársela."
msgstr "Collection or subject for «%s».\nLeave it empty to remove it."

msgid "Colección quitada."
msgstr "Collection removed."

msgid "Coloca o quita un marcador en la posición actual."
msgstr "Sets or removes a bookmark at the current position."

msgid "Color de la &letra:"
msgstr "&Text colour:"

msgid "Color del f&ondo:"
msgstr "&Background colour:"

msgid "Color propio %s"
msgstr "Custom colour %s"

msgid "Columna %d"
msgstr "Column %d"

msgid "Columna anterior o siguiente de esa fila"
msgstr "Previous or next column of that row"

msgid "Columnas de la lis&ta de libros:"
msgstr "Columns of the book lis&t:"

msgid "Columnas de la lista de libros"
msgstr "Columns of the book list"

msgid "Columnas propias de calibre"
msgstr "Your own calibre columns"

msgid "Com&probar todas"
msgstr "&Check them all"

msgid "Combinación &elegida:"
msgstr "&Chosen combination:"

msgid "Combinación elegida"
msgstr "Chosen combination"

