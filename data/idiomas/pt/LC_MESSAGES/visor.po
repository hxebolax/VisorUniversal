msgstr "Arte, fotografia e história"

msgid "Asigna la combinación que se acaba de pulsar. Si ya está cogida por otro programa, se dice."
msgstr "Atribui a combinação que acabou de ser pressionada. Se já foi capturado por outro programa, diz-se."

msgid "Asistente"
msgstr "Assistente"

msgid "Asistente para instalar la IA local"
msgstr "Assistente de instalação de IA local"

msgid "Asterisco del teclado numérico"
msgstr "Asterisco do teclado numérico"

