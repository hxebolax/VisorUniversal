msgid "«%s» aparece en el DLE, pero sin ninguna acepción legible."
msgstr "\"%s\" apparaît dans le DLE, mais sans aucune signification lisible."

msgid "«%s» es un modificador, no una tecla. Mantén los modificadores y pulsa además una letra, un número o una tecla como F8 o Inicio."
msgstr "\"%s\" est un modificateur, pas une clé. Maintenez les modificateurs enfoncés et appuyez également sur une lettre, un chiffre ou une touche telle que F8 ou Accueil."

msgid "«%s» está cifrado. Escribe la contraseña para leerlo."
msgstr "« %s » est crypté. Entrez le mot de passe pour le lire."

msgid "«%s» está en el Wikcionario, pero sin definición."
msgstr "« %s » est dans le Wiktionnaire, mais sans définition."

msgid "«%s» está fallando ahora mismo (error %d del servidor). No es cosa tuya: prueba más tarde."
msgstr "\"%s\" échoue actuellement (erreur de serveur %d). Cela ne dépend pas de vous : essayez plus tard."

msgid "«%s» está instalado y ya es el motor elegido. Pruébalo con el botón «Probar la voz» de la pestaña «Voz»."
msgstr "\"%s\" est installé et constitue désormais le moteur choisi. Essayez-le avec le bouton « Test Voice » dans l'onglet « Voice »."

msgid "«%s» está instalado, pero ya lo estabas usando y sus archivos siguen abiertos.\n\nCierra el programa y vuelve a abrirlo: hasta entonces esas voces no van a sonar."
msgstr "\"%s\" est installé, mais vous l'utilisiez déjà et ses fichiers sont toujours ouverts.\n\nFermez le programme et rouvrez-le : d'ici là, ces voix ne retentiront pas."

msgid "«%s» está pidiendo que se espere: se le han hecho demasiadas peticiones seguidas. Prueba dentro de un rato."
msgstr "\"%s\" demande d'attendre : trop de demandes ont été faites à la suite. Essayez-le dans un moment."

msgid "«%s» no deja entrar sin haber iniciado sesión. Ábrela en el navegador, inicia sesión y guárdala con «Guardar como»; después se abre desde aquí."
msgstr "\"%s\" ne permet pas l'entrée sans être connecté. Ouvrez-le dans le navigateur, connectez-vous et enregistrez-le avec \"Enregistrer sous\" ; puis il s'ouvre à partir d'ici."

msgid "«%s» no es un archivo GGUF. Los modelos para Ollama son archivos con extensión .gguf; si lo has bajado de Hugging Face, es el que pone «GGUF» y no el de pesos originales."
msgstr "\"%s\" n'est pas un fichier GGUF. Les modèles pour Ollama sont des fichiers avec une extension .gguf ; Si vous l'avez téléchargé depuis Hugging Face, c'est celui qui dit « GGUF » et non celui avec les pesos originaux."

msgid "«%s» no está en el Wikcionario."
msgstr "« %s » n'est pas dans le Wiktionnaire."

msgid "«%s» no está en el diccionario de la RAE."
msgstr "«%s» n'est pas dans le dictionnaire RAE."

msgid "«%s» no sale lo bastante en tus libros como para saber con qué se relaciona."
msgstr "\"%s\" n'apparaît pas suffisamment dans vos livres pour savoir à quoi il se rapporte."

msgid "«%s» no se dice"
msgstr "\"%s\" n'est pas dit"

msgid "«%s» pasa a ser el prompt por omisión."
msgstr "\"%s\" devient l'invite par défaut."

msgid "«%s» sale en demasiados sitios: no hay ninguna palabra que se le parezca en particular."
msgstr "\"%s\" apparaît à trop d'endroits : il n'y a pas de mot qui lui ressemble particulièrement."

msgid "«%s» ya está en la biblioteca.\n\n¿Quieres actualizarla ahora?"
msgstr "« %s » est déjà dans la bibliothèque.\n\nVoulez-vous l'actualiser maintenant ?"

msgid "«%s» ya no está. Queda puesta la voz de Windows."
