msgstr "Dites la description lorsque vous arrivez à une image"

msgid "Decir la descripción guardada al &llegar a una imagen"
msgstr "Dites la description enregistrée lorsque &vous arrivez à une image"

msgid "Decir por dónde va la lectura"
msgstr "Dites où va la lecture"

