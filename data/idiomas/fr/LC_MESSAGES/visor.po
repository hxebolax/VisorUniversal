msgstr "Le PDF est corrompu ou ne peut pas être ouvert : %s"

msgid "El PDF está dañado y no se ha podido reparar."
msgstr "Le PDF est corrompu et n'a pas pu être réparé."

msgid "El PDF no contiene texto legible y no se ha podido reconocer ninguna página."
msgstr "Le PDF ne contient aucun texte lisible et aucune page n'a pu être reconnue."

msgid "El PDF no lleva estructura: no dice qué es un título, una tabla ni una imagen."
msgstr "Le PDF n'a pas de structure : il ne dit pas ce qu'est un titre, un tableau ou une image."

msgid "El PDF no tiene ninguna página."
msgstr "Le PDF ne contient aucune page."

msgid "El PDF se declara etiquetado pero no trae árbol de estructura."
msgstr "Le PDF est déclaré balisé mais ne comporte pas d'arborescence de structure."

